{
  "mcpServers": {
    "qdrant": {
      "command": "uvx",
      "args": ["--from", "${CLAUDE_PLUGIN_ROOT}", "qdrant-full-mcp"],
      "env": {
        "QDRANT_CLOUD_API_KEY": "${QDRANT_CLOUD_API_KEY:-}",
        "QDRANT_CLOUD_ACCOUNT_ID": "${QDRANT_CLOUD_ACCOUNT_ID:-}",
        "QDRANT_URL": "${QDRANT_URL:-}",
        "QDRANT_API_KEY": "${QDRANT_API_KEY:-}"
      }
    }
  }
}

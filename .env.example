# --- Qdrant Cloud management (cloud module) ---
# Console -> Access Management -> Cloud Management Keys
QDRANT_CLOUD_API_KEY=

# Optional: auto-detected from the key if it has exactly one account
# QDRANT_CLOUD_ACCOUNT_ID=

# --- Qdrant database (data module) ---
# Cluster endpoint, e.g. https://<cluster-id>.<region>.cloud.qdrant.io:6333 or http://localhost:6333
QDRANT_URL=
# Database API key for that cluster (not the management key). Optional for local unauthenticated Qdrant.
QDRANT_API_KEY=
# Or run without any server: a folder for the data (or :memory:). Use instead of QDRANT_URL.
# QDRANT_LOCAL_PATH=./qdrant-data

# --- Plain-text memory (text module) ---
# COLLECTION_NAME=memory            # default collection for store_text/find_text (one-step store)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# QDRANT_SEARCH_LIMIT=5
# TOOL_STORE_DESCRIPTION=Store a reusable code snippet with a short description
# TOOL_FIND_DESCRIPTION=Find code snippets relevant to the request

# --- Optional ---
# QDRANT_MCP_MODULES=cloud,data,text  # expose only what you need (default: all)
# QDRANT_MCP_TRANSPORT=stdio          # or sse / streamable-http (binds 127.0.0.1:8000, see FASTMCP_HOST/FASTMCP_PORT)
# QDRANT_MCP_READ_ONLY=1            # block every confirmed write/delete
# QDRANT_CLOUD_API_URL=https://api.cloud.qdrant.io

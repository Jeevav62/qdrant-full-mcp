# --- Qdrant Cloud management (cloud module) ---
# Console -> Access Management -> Cloud Management Keys
QDRANT_CLOUD_API_KEY=

# Optional: auto-detected from the key if it has exactly one account
# QDRANT_CLOUD_ACCOUNT_ID=

# --- Qdrant database (data module) ---
# Cluster endpoint, e.g. https://<cluster-id>.<region>.cloud.qdrant.io:6333 or http://localhost:6333
QDRANT_URL=
# Database API key for that cluster (not the management key). Optional for local unauthenticated Qdrant.
QDRANT_API_KEY=

# --- Optional ---
# QDRANT_MCP_MODULES=cloud,data     # expose only what you need (default: both)
# QDRANT_MCP_READ_ONLY=1            # block every confirmed write/delete
# QDRANT_CLOUD_API_URL=https://api.cloud.qdrant.io
